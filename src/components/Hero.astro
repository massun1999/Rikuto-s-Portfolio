---
import { site } from '../data/site';
---

<section class="hero" aria-label="イントロ">
  <div class="hero__plane" aria-hidden="true"></div>
  <div class="container hero__content">
    <p class="hero__eyebrow">{site.title}</p>
    <h1 class="hero__name">{site.name}</h1>
    <p class="hero__kana">{site.fullName}</p>
    <p class="hero__tagline">{site.tagline}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="#works">作品を見る</a>
      <a class="btn btn--ghost" href="#contact">連絡する</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 56rem);
    display: grid;
    align-items: end;
    padding-block: clamp(5rem, 14vw, 9rem) clamp(3rem, 8vw, 5rem);
    overflow: clip;
  }

  .hero__plane {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(120deg, rgba(15, 138, 122, 0.22), transparent 42%),
      linear-gradient(200deg, rgba(16, 24, 32, 0.08), transparent 55%),
      radial-gradient(ellipse 70% 55% at 78% 30%, rgba(15, 138, 122, 0.28), transparent 60%);
    animation: plane-drift 14s ease-in-out infinite alternate;
  }

  .hero__plane::after {
    content: '';
    position: absolute;
    inset: 12% 8% auto auto;
    width: min(42vw, 28rem);
    aspect-ratio: 1;
    border: 1px solid rgba(16, 24, 32, 0.14);
    border-radius: 42% 58% 48% 52%;
    transform: rotate(-12deg);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.35), transparent 60%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
  }

  .hero__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-deep);
    opacity: 0;
    animation: rise 0.8s ease forwards 0.1s;
  }

  .hero__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4.2rem, 16vw, 9.5rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.9;
    opacity: 0;
    animation: rise 0.9s ease forwards 0.2s;
  }

  .hero__kana {
    margin: 0.85rem 0 0;
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    opacity: 0;
    animation: rise 0.8s ease forwards 0.35s;
  }

  .hero__tagline {
    margin: 1.5rem 0 0;
    max-width: 28rem;
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    color: var(--ink-soft);
    opacity: 0;
    animation: rise 0.8s ease forwards 0.45s;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
    opacity: 0;
    animation: rise 0.8s ease forwards 0.55s;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.85rem;
    padding: 0 1.25rem;
    border: 1px solid transparent;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn--primary {
    background: var(--ink);
    color: #f5f8fb;
  }

  .btn--primary:hover {
    background: var(--accent-deep);
    color: #f5f8fb;
  }

  .btn--ghost {
    border-color: var(--line);
    background: rgba(255, 255, 255, 0.45);
  }

  .btn--ghost:hover {
    border-color: var(--accent);
    color: var(--accent-deep);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes plane-drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(-1.5%, 1.5%, 0) scale(1.03);
    }
  }
</style>
