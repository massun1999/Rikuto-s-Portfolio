---
import { site } from '../data/site';
import ScribbleDraw from './ScribbleDraw.astro';

const headline = ['得意を磨く。', '特異になる。', '化ける。'] as const;
---

<section class="mv" aria-label="メインビジュアル">
  <div class="mv__frame">
    <p class="mv__brand">{site.brand}</p>

    <h1 class="mv__headline">
      {headline.map((line) => <span>{line}</span>)}
    </h1>

    <ScribbleDraw variant="pc" />
    <ScribbleDraw variant="sp" />

    <div class="mv__art" aria-hidden="true">
      <img
        class="mv__lines mv__lines--pc"
        src="/images/mv/lines.svg"
        alt=""
        width="1323"
        height="926"
        decoding="async"
      />
      <img
        class="mv__lines mv__lines--sp"
        src="/images/mv/lines-sp.svg"
        alt=""
        width="352"
        height="596"
        decoding="async"
      />
      <div class="mv__walker-wrap">
        <img
          class="mv__walker"
          src="/images/mv/walker.webp"
          alt=""
          width="1152"
          height="1728"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .mv {
    position: relative;
    overflow: clip;
    background: var(--color-bg);
  }

  .mv__frame {
    position: relative;
    width: min(100%, var(--mv-max));
    margin-inline: auto;
    min-height: min(100dvh, 69.375rem);
    aspect-ratio: 1512 / 1110;
  }

  .mv__brand {
    position: absolute;
    z-index: 3;
    top: 3.7%;
    left: 3.3%;
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-brand);
    font-weight: 700;
    letter-spacing: var(--track-brand);
    line-height: 2;
    white-space: nowrap;
  }

  .mv__headline {
    position: absolute;
    z-index: 3;
    top: 12.3%;
    left: 27.4%;
    display: flex;
    flex-direction: column;
    width: max-content;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-headline);
    font-weight: 700;
    letter-spacing: var(--track-headline);
    line-height: 2;
  }

  .mv__headline span {
    display: block;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(0.6rem);
    animation: mv-rise 0.85s ease forwards;
  }

  .mv__headline span:nth-child(1) {
    animation-delay: 0.08s;
  }
  .mv__headline span:nth-child(2) {
    animation-delay: 0.2s;
  }
  .mv__headline span:nth-child(3) {
    animation-delay: 0.32s;
  }

  .mv__art {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .mv__lines {
    position: absolute;
    height: auto;
  }

  .mv__lines--pc {
    top: 33.1%;
    left: 0;
    width: 87.4%;
  }

  .mv__lines--sp {
    display: none;
  }

  .mv__walker-wrap {
    position: absolute;
    top: 24.6%;
    left: 6.75%;
    width: 12.04%;
    aspect-ratio: 182 / 709;
    overflow: hidden;
    opacity: 0;
    animation: mv-rise 1s ease forwards 0.25s;
  }

  .mv__walker {
    position: absolute;
    width: 326.35%;
    height: 125.49%;
    max-width: none;
    left: -118.41%;
    top: -11.4%;
    object-fit: cover;
  }

  @keyframes mv-rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* SP: Figma iPhone 16 & 17 Pro (402 × 982) */
  @media (max-width: 768px) {
    .mv {
      min-height: 100dvh;
      display: grid;
      place-items: center;
    }

    .mv__frame {
      width: min(100%, 25.125rem, calc(100dvh * 402 / 982));
      aspect-ratio: 402 / 982;
      min-height: 0;
      margin-inline: auto;
    }

    .mv__brand {
      top: 4.68%; /* 46 / 982 */
      left: 50%;
      transform: translateX(-50%);
    }

    .mv__headline {
      top: 11.4%; /* 112 / 982 */
      left: 4%;
      line-height: 1.75;
    }

    .mv__lines--pc {
      display: none;
    }

    .mv__lines--sp {
      display: block;
      top: 39%; /* 383 / 982 */
      left: 0;
      width: 87.3%; /* 351 / 402 */
    }

    .mv__walker-wrap {
      top: 36.25%; /* 356 / 982 */
      left: 8.2%; /* 33 / 402 */
      width: 24.6%; /* 99 / 402 */
      aspect-ratio: 99 / 387;
    }
  }
</style>
