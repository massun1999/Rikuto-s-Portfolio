---
import { projects } from '../data/site';
---

<section class="section works" id="works">
  <div class="container">
    <div class="reveal">
      <p class="section__label">Works</p>
      <h2 class="section__title">Selected work</h2>
      <p class="section__lead">最近手がけたプロジェクトの抜粋です。詳細は順次追加予定。</p>
    </div>

    <ul class="works__list">
      {
        projects.map((project, index) => (
          <li class="works__item reveal" style={`transition-delay: ${index * 80}ms`}>
            <a class="works__link" href={project.href}>
              <div class="works__top">
                <span class="works__year">{project.year}</span>
                <span class="works__role">{project.role}</span>
              </div>
              <h3 class="works__title">{project.title}</h3>
              <p class="works__summary">{project.summary}</p>
              <p class="works__stack">{project.stack.join(' · ')}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .works__list {
    list-style: none;
    margin: 2.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .works__item {
    border-top: 1px solid var(--line);
  }

  .works__item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .works__link {
    display: block;
    padding: 1.6rem 0.25rem;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .works__link:hover {
    background: rgba(15, 138, 122, 0.06);
  }

  .works__top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.65rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .works__year {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .works__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .works__summary {
    margin: 0.7rem 0 0;
    max-width: 40rem;
    color: var(--ink-soft);
  }

  .works__stack {
    margin: 1rem 0 0;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--accent-deep);
  }
</style>
