---
import { site } from '../data/site';
---

<footer class="site-footer">
  <p class="site-footer__copy">®︎{site.name}</p>
</footer>

<style>
  .site-footer {
    padding-block: 1.5rem 2.5rem;
    text-align: center;
  }

  .site-footer__copy {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(0.875rem, 0.8rem + 0.25vw, 1.125rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 2;
  }

  @media (max-width: 768px) {
    .site-footer {
      padding-block: 0 3rem; /* CTA already has 48px bottom; keep footer compact */
      padding-inline: 1.5rem;
      overflow-x: clip;
    }

    .site-footer__copy {
      font-size: 0.8125rem;
      font-weight: 500;
      letter-spacing: 0.1em;
    }
  }
</style>
