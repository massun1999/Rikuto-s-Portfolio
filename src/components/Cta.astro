---
import { cta, site, performance } from '../data/site';
---

<section class="cta" id="contact" aria-labelledby="cta-heading">
  <div class="cta__inner">
    <div class="cta__stage">
      <div class="cta__figure" aria-hidden="true">
        <img
          src={performance.figures.right.src}
          alt=""
          width={performance.figures.right.width}
          height={performance.figures.right.height}
          loading="lazy"
          decoding="async"
        />
      </div>
      <p class="cta__eyebrow reveal">{cta.eyebrow}</p>
      <a class="cta__button reveal" href={site.ctaHref} target="_blank" rel="noreferrer">
        <span id="cta-heading">{cta.button}</span>
        <img class="cta__button-arrow" src="/images/cta/arrow.svg" alt="" width="24" height="24" decoding="async" />
      </a>
    </div>
    <p class="cta__note reveal">{cta.note}</p>
  </div>
</section>

<style>
  .cta {
    width: min(100% - (var(--space-inline) * 2), 30rem);
    margin-inline: auto;
    padding-block: clamp(3rem, 2rem + 4vw, 5rem) clamp(2.5rem, 1.5rem + 3vw, 4rem);
    text-align: center;
  }

  .cta__inner {
    position: relative;
  }

  .cta__figure {
    display: none;
  }

  .cta__eyebrow,
  .cta__note {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(0.875rem, 0.8rem + 0.25vw, 1rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 2;
  }

  .cta__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    width: min(100%, 24.875rem);
    min-height: 5.125rem;
    margin: 1.1rem 0 1.25rem;
    padding: 0 1.5rem;
    background: var(--color-ink);
    color: #fff;
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 0.85rem + 0.3vw, 1.125rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 2;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .cta__button:hover,
  .cta__button:focus-visible {
    opacity: 0.8;
  }

  .cta__button-arrow {
    width: 1.5rem;
    height: 1.5rem;
  }

  @media (max-width: 768px) {
    .cta {
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      padding-inline: 1.5rem; /* 24px */
      padding-block: 2.5rem 3rem; /* 40px from note / 48px to footer */
      overflow-x: clip;
      text-align: center;
    }

    .cta__stage {
      position: relative;
      /* 座り絵全体の高さ分（下端はボタンに少しだけ隠れる） */
      padding-top: 10rem;
    }

    .cta__figure {
      display: block;
      position: absolute;
      right: 0;
      /* 下端をボタン上辺より少し下へ → 足元だけボタンに隠れる */
      bottom: 2rem;
      width: min(36%, 8.75rem); /* max 140px */
      max-width: 8.75rem;
      z-index: 1;
      pointer-events: none;
    }

    .cta__figure img {
      display: block;
      width: 100%;
      height: auto;
    }

    .cta__eyebrow {
      position: relative;
      z-index: 3;
      margin: 0 auto 0.75rem; /* 12px above button */
      font-size: 0.8125rem; /* 13px */
      font-weight: 400;
      letter-spacing: 0.04em;
      line-height: 1.8;
      text-align: center;
    }

    .cta__button {
      position: relative;
      z-index: 2; /* イラストより前面：下端だけ隠す */
      display: flex;
      justify-content: center;
      width: 100%;
      height: 3.5rem; /* 56px */
      min-height: 3.5rem;
      margin: 0;
      padding: 0 1.25rem;
      font-size: 0.9375rem; /* 15px */
      font-weight: 700;
      letter-spacing: 0.1em;
      line-height: 1;
    }

    .cta__button-arrow {
      position: absolute;
      right: 1.25rem; /* 20px */
      top: 50%;
      transform: translateY(-50%);
      width: 1.25rem;
      height: 1.25rem;
    }

    .cta__note {
      margin-top: 0.75rem; /* 12px */
      font-size: 0.75rem; /* 12px */
      font-weight: 400;
      letter-spacing: 0.04em;
      line-height: 1.8;
      color: #666;
      text-align: center;
    }
  }
</style>
