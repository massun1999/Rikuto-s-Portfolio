---
import { site } from '../data/site';
---

<section class="section about" id="about">
  <div class="container reveal">
    <p class="section__label">About</p>
    <h2 class="section__title">つくる人と、使う人のあいだを設計する</h2>
    <p class="section__lead">
      {site.fullName}。プロダクトの体験設計からフロントエンド実装までを一貫して担当しています。
      見た目の美しさだけでなく、読みやすさ・速さ・保守性まで含めて「ちゃんと使える」ものを目指しています。
    </p>
    <dl class="about__meta">
      <div>
        <dt>Based in</dt>
        <dd>{site.location}</dd>
      </div>
      <div>
        <dt>Focus</dt>
        <dd>UI / Frontend / DX</dd>
      </div>
      <div>
        <dt>Stack</dt>
        <dd>TypeScript · Astro · React</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .about__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.5rem;
    margin: 2.5rem 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .about__meta dt {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-deep);
  }

  .about__meta dd {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 500;
  }
</style>
